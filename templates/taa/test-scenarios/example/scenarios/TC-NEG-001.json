{
  "schema_version": "1.0",
  "test_id": "TC-NEG-001",
  "test_name": "Hatalı şifre ile giriş denemesi reddedilir",
  "level": "normal",
  "layer": "NEG",
  "priority": "P0",
  "page": { "name": "Giriş", "route": "/login", "source": "apps/web/src/app/(auth)/login/page.tsx:1" },
  "target_url": "{{BASE_URL}}/login",
  "preconditions": {
    "auth": { "mode": "anonymous" },
    "seed": ["Aktif durumda kullanıcı (TEST_USER_EMAIL) mevcut"],
    "viewport": "desktop"
  },
  "test_data": {
    "email": "{{env.TEST_USER_EMAIL}}",
    "invalid_password": "Yanlis!Sifre42"
  },
  "steps": [
    {
      "step_id": 1,
      "description": "Giriş sayfasının yüklenmesi ve kontrolü",
      "laya_question": "Bu sayfa geçerli bir kullanıcı giriş formu içeriyor mu?",
      "expected_primitive": "noul",
      "expected": { "answer": true, "min_confidence": 0.8 },
      "automation": {
        "actions": [{ "action": "goto", "url": "{{BASE_URL}}/login" }],
        "assertions": [
          { "type": "visible", "locator": { "by": "label", "value": "E-posta" } },
          { "type": "visible", "locator": { "by": "label", "value": "Şifre" } }
        ]
      }
    },
    {
      "step_id": 2,
      "description": "Form elementlerinin tespiti ve hatalı şifreyle doldurulması",
      "question_phase": "before_actions",
      "laya_question": "Şu anki ekranda bir sonraki mantıklı aksiyon ne olmalı?",
      "expected_primitive": "choice",
      "options": ["formu_doldur", "hata_mesajini_oku", "sayfayi_terk_et"],
      "expected": { "answer": "formu_doldur" },
      "automation": {
        "actions": [
          { "action": "fill", "locator": { "by": "label", "value": "E-posta" }, "value": "{{test_data.email}}" },
          { "action": "fill", "locator": { "by": "label", "value": "Şifre" }, "value": "{{test_data.invalid_password}}" },
          { "action": "click", "locator": { "by": "role", "role": "button", "name": "Giriş yap" } }
        ],
        "assertions": []
      }
    },
    {
      "step_id": 3,
      "description": "Hata uyarısının doğrulanması",
      "laya_question": "Ekranda kırmızı renkli veya 'geçersiz/hatalı' ibareli bir uyarı metni belirdi mi?",
      "expected_primitive": "noul",
      "expected": { "answer": true, "min_confidence": 0.8 },
      "automation": {
        "actions": [],
        "assertions": [
          { "type": "visible", "locator": { "by": "role", "role": "alert" } },
          { "type": "text_contains", "locator": { "by": "role", "role": "alert" }, "value": "E-posta veya şifre hatalı" },
          { "type": "url_matches", "value": "/login$" },
          { "type": "response", "url_pattern": "/api/auth/login", "method": "POST", "status": 401 }
        ]
      }
    },
    {
      "step_id": 4,
      "description": "Hata mesajının anlaşılırlığının değerlendirilmesi",
      "laya_question": "Hata mesajının kullanıcıya ne yapması gerektiğini anlatma netliğini 1 ile 5 arasında puanla.",
      "expected_primitive": "score",
      "scale": { "min": 1, "max": 5 },
      "expected": { "gte": 3 },
      "automation": { "actions": [], "assertions": [] },
      "on_fail": "continue"
    }
  ],
  "traceability": {
    "spec": ["SPEC §2 AC-3"],
    "endpoints": ["POST /api/auth/login"],
    "sources": ["apps/web/src/app/(auth)/login/page.tsx:1"]
  },
  "verification": "code-only",
  "tags": ["auth", "negative"]
}
