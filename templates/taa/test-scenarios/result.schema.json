{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "taa/test-scenarios/result.schema.json",
  "title": "TAA test scenario execution result",
  "description": "One file per execution under <test-scenarios>/results/<YYYYMMDD-HHMM>-<executor>.json — written by taa-tester RUN mode, a human tester, or the Laya runner, so every executor reports the same shape.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "executed_at", "executor", "environment", "level", "results", "summary"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string" },
    "executed_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
    "executor": { "enum": ["playwright-mcp", "playwright", "laya", "human"] },
    "executor_detail": { "type": "string", "description": "e.g. tester name, Laya model version, browser" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_url", "kind"],
      "properties": {
        "base_url": { "type": "string" },
        "kind": { "enum": ["local", "staging", "test"], "description": "Production is never a valid target (CLAUDE.md QA rule 1)." }
      }
    },
    "level": { "enum": ["light", "normal", "hard"] },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test_id", "status", "steps"],
        "properties": {
          "test_id": { "type": "string", "pattern": "^TC-[A-Z0-9]+-[0-9]{3}$" },
          "status": { "enum": ["pass", "fail", "inconclusive", "blocked", "skipped"] },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "note": { "type": "string" },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["step_id", "status"],
              "properties": {
                "step_id": { "type": "integer", "minimum": 1 },
                "status": { "enum": ["pass", "fail", "inconclusive", "blocked", "skipped"] },
                "answer": {
                  "type": ["boolean", "string", "number"],
                  "description": "The executor's answer to laya_question: noul -> p(yes) in [0,1] (Laya) or true/false (human); choice -> option key; score -> number."
                },
                "assertions_passed": { "type": "integer", "minimum": 0 },
                "assertions_failed": { "type": "integer", "minimum": 0 },
                "judgement_only": { "type": "boolean", "description": "true when the step had no deterministic assertion and a headless runner could only execute its actions" },
                "evidence": { "type": "array", "items": { "type": "string" }, "description": "Relative paths to screenshots/traces/console dumps under results/" },
                "note": { "type": "string" },
                "laya": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["phase", "verdict", "probabilities"],
                  "description": "Laya model detail (runner executor): what it saw and how sure it was.",
                  "properties": {
                    "phase": { "enum": ["before_actions", "after_actions"] },
                    "verdict": { "enum": ["match", "mismatch", "null"], "description": "null = noul answer fell in the inconclusive band" },
                    "probabilities": { "type": "object", "additionalProperties": { "type": "number" } },
                    "confidence": { "type": "number" },
                    "act_probability": { "type": "number" },
                    "input_tokens": { "type": "integer", "minimum": 0 },
                    "state_truncated": { "type": "boolean" },
                    "latency_ms": { "type": "integer", "minimum": 0 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "pass", "fail"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "pass": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "inconclusive": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
