<Project Sdk="Microsoft.NET.Sdk">

  <!-- Same runtime pair as the Laya guardrail console (onnx-console-app), which
       is proven against this exact model. Tokenizers.HuggingFace binds the Rust
       `tokenizers` crate, so encoding is identical to the Python reference. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.27.0" />
    <PackageReference Include="Tokenizers.HuggingFace" Version="3.23.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LayaJudge</RootNamespace>
    <AssemblyName>LayaJudge</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
