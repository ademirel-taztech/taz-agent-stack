.DS_Store
node_modules/
/bin/
!templates/bin/
!templates/bin/taa
!templates/bin/taa.ps1
!templates/bin/taa.cmd
obj/
__pycache__/
*.pyc

# Generated by doc-ingest/doc-export/eval-harness — regenerable, not source
# of truth. Everything under .taa/runs/<id>/ and .taa/archive/<id>/ (state,
# SPEC, backlog, review, etc.) is still meant to be committed; only these
# generated-output paths are excluded.
.taa/inputs/
.taa/reports/
**/evals/results-*
.claude/settings.json

# Laya model binaries (650 MB model.onnx, 34 MB tokenizer.json) — too large
# for git. Configs, README and SHA256SUMS under models/laya/<ver>/ ARE
# committed; install the binaries with scripts/taa-laya-model.sh.
models/laya/*/model.onnx
models/laya/*/tokenizer/tokenizer.json
models/laya/*/.DS_Store

# Laya Playwright runner build/run output
runner/node_modules/
runner/.laya-judge-bin/
runner/playwright-report/
runner/test-results/
